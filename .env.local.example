# Clé Google Places API (New). Voir README.md § « Setup Google Cloud ».
# Laisser vide tant que MOCK_EXTERNAL=1.
GOOGLE_PLACES_API_KEY=

# 1 = aucun appel sortant côté serveur : cachedFetch lit fixtures/ (dev par
#     défaut). Le fond de carte reste chargé par le navigateur chez CARTO.
# 0 = appels réels, consomme du quota Google.
MOCK_EXTERNAL=1

# Plafond de sécurité applicatif, en plus des quotas de la console Google.
PLACES_DAILY_CAP=300

# Préremplissage du champ "Adresse ou commune".
# En mode MOCK_EXTERNAL=1, seule "Tours" dispose d'un jeu de fixtures.
NEXT_PUBLIC_DEFAULT_CITY=Tours

# URL publique si l'app est déployée ; utile pour les images Open Graph.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dossier où Opportunity crée les vitrines sélectionnées. Laisser vide pour
# utiliser ../websites, soit Programmes/websites dans l'installation locale.
OPPORTUNITY_WEBSITES_DIR=

# Programme local qui finalise les vitrines placées dans la file. La commande
# reçoit uniquement des outils de lecture/écriture dans le dossier du projet.
OPPORTUNITY_WEBSITE_AGENT_COMMAND=claude

# Plafond par vitrine pour Claude Code ; 3 USD si cette valeur est absente ou
# invalide. Garder une valeur positive et au plus égale à 20.
OPPORTUNITY_WEBSITE_AGENT_MAX_BUDGET_USD=3
