# Clé Google Places API (New). Voir README.md § « Setup Google Cloud ».
# Laisser vide tant que MOCK_EXTERNAL=1.
GOOGLE_PLACES_API_KEY=

# 1 = aucun appel réseau réel : cachedFetch lit fixtures/ (dev par défaut).
# 0 = appels réels, consomme du quota Google.
MOCK_EXTERNAL=1

# Plafond de sécurité applicatif, en plus des quotas de la console Google.
PLACES_DAILY_CAP=300

# URL publique si l'app est déployée ; utile pour les images Open Graph.
NEXT_PUBLIC_APP_URL=http://localhost:3000
