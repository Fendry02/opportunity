# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files : jamais versionnés, ils contiennent la clé Google.
.env*
# ...sauf le gabarit, qui documente les variables attendues.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base SQLite locale (données de prospection, jamais versionnées)
/data

# plans et artefacts locaux de l'éditeur
/nimbalyst-local
/.nimbalyst
